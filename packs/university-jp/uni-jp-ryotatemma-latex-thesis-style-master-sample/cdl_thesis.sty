\usepackage{ifthen}

%%
%% ページ・レイアウト
%%
\def\baselinestretch{1.1}
\topmargin=-10mm
\oddsidemargin=0mm
\evensidemargin=0mm
\textheight=240mm	% 40行(11pt)
\textwidth=160mm	% 43字(11pt)

%%
%%  段落
%%
\parindent=1zw		% 段落の頭の字下げ

%%
%%  タイトル行数 (2001/01/12 Obsoleted)
%%
% \def\@titlelines{0}
% \def\titlelines#1{\def\@titlelines{#1}}
% \newlength{\titlelineskip}
