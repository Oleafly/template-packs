	author = {Dey, Tamal and Lai, Xinyuan and Manna, Sukriti and Patel, Karan and Patel, Ranjan Kumar and Bisht, Ravindra Singh and Zhou, Yue and Shah, Shaan and Andrei, Eva Y. and Sankaranarayanan, Subramanian K. R. S. and Kuzum, Duygu and Schuman, Catherine and Ramanathan, Shriram},
	urldate = {2026-04-10},
