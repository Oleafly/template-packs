@article{bonifacio_tem_2024,
	title = {{TEM} preparation and characterization of a {GeTe}-based phase change memory device at partial {SET} mode},
	volume = {30},
	issn = {1431-9276},
	url = {https://doi.org/10.1093/mam/ozae044.607},
	doi = {10.1093/mam/ozae044.607},
	abstract = {Phase change memory ({PCM}) uses the resistance difference between amorphous and crystalline states in phase change materials [1], such as Ge2Sb2Te5 and {GeTe}. Between these two materials, {GeTe} films are a good alternative to Ge2Sb2Te5 because of {GeTe}’s growth-dominated crystallization mode [2] and Ge2Sb2Te5’s large cycle-to-cycle variability [3]. Transmission electron microscopy ({TEM}) techniques can elucidate the crystallization modes in {GeTe}-based {PCM} devices at 100 nm scale. However, careful specimen preparation of {PCM} devices is critical as the phase change layer is susceptible to ion beam damage [4]. We previously showed Ga focused ion beam ({FIB}) preparation with post-{FIB} Ar milling of {TEM} specimens [5,6], but specimens prepared by a Xe plasma {FIB} ({pFIB}) followed by concentrated Ar ion milling constitutes new work. Producing electron-transparent {TEM} specimens using a Xe {pFIB} deviates from the standard Ga {FIB} method due to the relatively large Xe beam and its wide beam tails [7]. Here, we describe post-{pFIB} polishing by concentrated Ar ion milling of {TEM} specimens prepared using a Xe {pFIB} for controlled specimen thinning, which resulted in high quality specimens without Xe damage. Consequently, the growth dominated crystallization mechanism in {GeTe}-based, mushroom-type, {PCM} devices at partial {SET} state is revealed. By leaving the device in partial {SET} mode, crystallization of the initially amorphous areas formed during {RESET} programming in the {GeTe} layer is gradually controlled with the tunable intermediate electrical resistance.},
	pages = {ozae044.607},
	issue = {Supplement\_1},
	journaltitle = {Microscopy and Microanalysis},
	shortjournal = {Microsc. Microanal.},
	author = {Bonifacio, C S and Yu, Y and Ray, M L and Skowronski, M and Fischione, P},
	urldate = {2026-04-10},
	date = {2024-07-01},
	langid = {english},
	keywords = {⭐ New, !!\_CLASSIFY\_ME, ontology:local:background-knowledge, ontology:maturity:stable, ontology:material\_system:thin-films, ontology:application:memristor, ontology:characterization\_technique:tem},
}

@inproceedings{bonifacio_precise_2023,
	title = {Precise final thinning by concentrated Ar ion beam milling of plan view {TEM} specimens from phase change memory device prepared in Xe plasma {FIB}},
	url = {https://dx.doi.org/10.31399/asm.cp.istfa2023p0309},
	doi = {10.31399/asm.cp.istfa2023p0309},
	abstract = {Abstract. Advanced memory technologies are in demand with phase change memory ({PCM}) devices as a forefront candidate. For successful characterization by transmission electron microscopy ({TEM}) for failure analysis and device development, an accurate and controllable thinning of {TEM} specimens is critical. In this work, {TEM} specimens from a {GeTe}-based {PCM} device at a partial {SET} state were prepared using a Xe plasma focused ion beam ({pFIB}) and polished to electron transparency using Ar ion beam milling. We will highlight the differences between Ga focused ion beam ({FIB}) and Xe {pFIB} {TEM} specimen preparation, the benefits of post-{pFIB} Ar ion beam milling, and show {TEM} results of the effects of partial {SET} programming of the {GeTe} {PCM} device.},
