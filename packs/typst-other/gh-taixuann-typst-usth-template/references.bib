}

@article{li_parametric_2025,
	title = {Parametric study of “filament and gap” models of resistive switching in {TaOx}-based devices},
	volume = {137},
	issn = {0021-8979},
	url = {https://doi.org/10.1063/5.0246985},
	doi = {10.1063/5.0246985},
	abstract = {A finite element model consisting of a conducting filament with or without a gap was used to reproduce the behavior of {TaOx}-based resistive switching devices. The specific goal was to explore the range of possible filament parameters such as filament diameter, composition, gap width, and composition to reproduce the conductance and shape of I–V while keeping the maximum temperature within the acceptable range allowing for ion motion and preventing melting. The model solving heat and charge transport produced a good agreement with experimental data for the oxygen content in the filament below {TaO}1.3, the filament diameter range between 6 and 22 nm, and the gap oxygen content between {TaO}1.7 and {TaO}1.85. Gap width was not limited to either low or high sides according to the criteria considered in this report. The obtained filament composition corresponds to oxygen deficiency an order of magnitude higher than one estimated by other modeling efforts. This was in large part due to the use of recent experimental values of conductivity as a function of composition and temperature. Our modeling results imply that a large fraction of atoms leaves and/or accumulates within the filament to produce a large relative concentration change. This, in turn, necessitates the inclusion of strain energy in the filament formation modeling. In addition, the results reproduce non-linear I–V without the necessity of assuming the Poole–Frenkel type of electrical conduction or the presence of a barrier at the oxide/metal interface.},
	pages = {114501},
	number = {11},
	journaltitle = {Journal of Applied Physics},
	shortjournal = {J. Appl. Phys.},
	author = {Li, Rongchen and Bai, Yang and Skowronski, Marek},
	urldate = {2026-04-10},
	date = {2025-03-19},
	langid = {english},
	keywords = {⭐ New, !!\_CLASSIFY\_ME, ontology:characterization\_technique:iv-measurement, ontology:maturity:emerging, ontology:local:background-knowledge, ontology:application:memristor, ontology:domain:device-physics},
}

@incollection{skowronski_oxygen_1992,
	title = {Oxygen in gallium arsenide},
	abstract = {The effects of oxygen addition to {GaAs} crystals have been extensively investigated since the early 1960s. Two factors stimulated this interest throughout the past three decades. First was a potential of oxygen contamination during the growth process. The high reactivity of oxygen, its abundance in nature, and the use of oxides (in the form of {SiO}2 crucibles and as B2O3 encapsulant in Liquid Encapsulated Czochralski growth) in semiconductor technology makes oxygen a likely contaminant in all semiconductors. The severity of this problem has long been recognized in silicon growth. Intimate contact between molten silicon and the silica crucible results in its partial dissolution and high oxygen content in all Czochralski grown silicon crystals. Although the contamination level is typically as high as 1017–1018 cm−3 the electrical properties of silicon are not affected as much because of electrical inactivity of the main oxygen defect—isolated interstitial oxygen. In time, we have learned how to live with this potential problem and even how to take the advantage of oxygen presence.},
	booktitle = {Deep centers in semiconductors},
	publisher = {{CRC} Press},
	author = {Skowronski, M.},
	date = {1992},
	langid = {english},
	note = {Num Pages: 28},
	keywords = {⭐ New, !!\_CLASSIFY\_ME, ontology:maturity:stable, ontology:application:beyond-cmos, ontology:material\_system:thin-films, ontology:local:archive},
}

@article{bonifacio_precise_2024,
	title = {Precise final specimen thinning by concentrated argon ion beam milling of plan view {TEM} specimens prepared in the xenon plasma {FIB}},
