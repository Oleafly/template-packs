@article{woodward_artificial_nodate,
	title = {Artificial coater: an In situ self-driving lab reveals design rules and mechanisms for ambient perovskite film fabrication},
	volume = {2026},
	url = {https://chemrxiv.org/doi/full/10.26434/chemrxiv.15001176/v1},
	doi = {10.26434/chemrxiv.15001176/v1},
	shorttitle = {Artificial coater},
	abstract = {Ambient solution-processing of metal halide perovskites remains highly sensitive to subtle variations in environment, formulation, and human technique, often leading to unpredictable outcomes and limited mechanistic understanding. Despite rapid advances in materials and device performance, researchers continue to rely heavily on manual and intuition-driven optimization, inconsistent fabrication protocols, and subjective film quality evaluation. These challenges persist across diverse coating methods, including but not limited to antisolvent dripping, which is especially sensitive to ambient manufacturing. In this work, we present the Artificial Coater, a self-driving laboratory platform that integrates closed-loop Bayesian optimization, in situ {UV}-Vis and photoluminescence spectroscopy, and machine vision to optimize thin film fabrication autonomously, reveal film formation mechanisms, and underlying root causes of unsuccessful fabrication. To enable scalable and unbiased interpretation of in situ spectral evolution, we apply non-negative matrix factorization across thousands of spectra, revealing latent spectral features associated with successful versus failed coatings. Using the benchmark composition {FA}₀.₈₃Cs₀.₁₇Pb(I₀.₈₃Br₀.₁₇)₃, we identify critical processing parameters governing crust formation, nucleation uniformity, and phase evolution. Our approach uncovers mechanistic insights into the formation of compact and uniformly converted perovskite thin films versus films exhibiting visibly rough morphologies across the coated area, links variations in morphology to solvent extractionmediated crystallization and reveals antisolvent drip design rules. This study establishes a dataintensive in situ framework with materials processing transparency, providing reusable and interpretable data for broader applications, including for potential transferability to other fabrication platforms and materials prepared using antisolvent drip.},
	number = {324},
	journaltitle = {{ChemRxiv}},
	shortjournal = {{ChemRxiv}},
	publisher = {{ChemRxiv}},
	author = {Woodward, Nathan and Guo, Boyu and Chauhan, Mihir and Mauthe, Jacob and Thapa, Gaurab J and Bharodiya, Yash and Muth, John F and Abolhasani, Milad and Reyes, Kristofer G and Amassian, Aram},
	urldate = {2026-04-10},
	langid = {english},
	keywords = {⭐ New, !!\_CLASSIFY\_ME, ontology:local:active-research, ontology:maturity:emerging, ontology:application:sensor, ontology:domain:materials-science, ontology:characterization\_technique:uv-vis, ontology:material\_system:thin-films},
}

@article{seyitliyev_singlet_nodate,
	title = {Singlet fission enables triplet sensitization of narrow gap hybrid perovskites},
	volume = {2026},
	url = {https://chemrxiv.org/doi/full/10.26434/chemrxiv-2026-bxv8r},
	doi = {10.26434/chemrxiv-2026-bxv8r},
	abstract = {Materials that exhibit singlet fission, where a high-energy photon generates two lower energy triplet excitons, open interesting opportunities to surpass the Shockley-Queisser limit in single-junction solar cells. Although existing candidates such as {TIPS}-Pentacene achieve high triplet exciton yields, the low energy of these triplets (1eV) limits their application to modern thin-film solar cell applications, such as hybrid perovskites, where band gaps remain {\textgreater}1.25 {eV}. In this study, we investigate and report triplet energy transfer from a high-energy singlet fission material, 9,10-dicyanoanthracene ({DCA}), to the low bandgap {FA}0.5MA0.5Pb0.5Sn0.5I3. Photoluminescence measurements reveal triplet transfer from {DCA} to the perovskite resulting in one order magnitude increased emission intensity. This claim is validated by correlating the energy threshold for this process with the singlet fission generation threshold in {DCA} (3eV). Carrier lifetime is extended by an order of magnitude in {DCA}/perovskite systems as revealed by transient absorption spectroscopy. This study provides an important first step towards the successful sensitization of hybrid perovskites with wide bandgap singlet fission molecules.},
	number = {109},
	journaltitle = {{ChemRxiv}},
	shortjournal = {{ChemRxiv}},
	publisher = {{ChemRxiv}},
	author = {Seyitliyev, Dovletgeldi and Darabi, Kasra and Amassian, Aram and Gundogdu, Kenan},
	urldate = {2026-04-10},
	langid = {english},
	keywords = {⭐ New, !!\_CLASSIFY\_ME, ontology:application:sensor, ontology:local:background-knowledge, ontology:characterization\_technique:uv-vis, ontology:material\_system:thin-films, ontology:maturity:speculative},
}

@article{guo_stress-diffusion-stability_nodate,
	title = {A stress-diffusion-stability framework enables ambient fabrication of hybrid perovskites with extended environmental stability},
	volume = {2025},
	url = {https://chemrxiv.org/doi/full/10.26434/chemrxiv-2025-128tn},
	doi = {10.26434/chemrxiv-2025-128tn},
	abstract = {Hybrid perovskites have become a leading candidate for next-generation photovoltaic applications, but they still suffer from several intrinsic and extrinsic sources of instability. Residual tensile stress has emerged as a major source of extrinsic instability, as it originates from thin film fabrication and choice of substrate. Here, we propose an experimentally validated mechanical stress-diffusion framework which links dynamic stress relaxation behavior of perovskites to vacancy-mediated grain boundary ({GB}) halide diffusional, namely, Coble creep. Using temperature-dependent in situ analysis of stress and strain relaxation across the perovskite composition, we quantitatively link these mechanisms. We extend this framework to link these mechanisms to material stability in the context of ambient manufacturing in the presence of humidity. The Coble creep mechanism is circumvented by the fast diffusion of water molecules, with potentially severe impact on material degradation. We show how pre-relaxation of perovskite films in a dry environment (0\% {RH} and N2) extends lifetime from {\textless}100 hours to {\textgreater}1,000 hours in moderately humid air by removing the driving force for moisture uptake. This work identifies the fundamental mechanisms of stress relaxation and diffusion responsible for moisture uptake and proposes stress relaxation approaches which facilitate ambient manufacturing of existing materials and fabrication approaches under moderate humidity conditions.},
	number = {1230},
	journaltitle = {{ChemRxiv}},
	shortjournal = {{ChemRxiv}},
	publisher = {{ChemRxiv}},
	author = {Guo, Boyu and {McAndrews}, Gabriel and Kaczaral, Samantha and Li, Jiazhen and Gu, Qing and {McGehee}, Michael and Amassian, Aram},
	urldate = {2026-04-10},
	langid = {english},
	keywords = {⭐ New, !!\_CLASSIFY\_ME, ontology:maturity:emerging, ontology:application:sensor, ontology:local:background-knowledge, ontology:domain:materials-science, ontology:material\_system:thin-films},
}

@article{sadath_high-performance_2025,
