	langid = {english},
	keywords = {\#type/review, 📖 In Progress, \#charact/cv, \#concept\_type/mechanism, \#domain/electrochemistry, \#mechanism/redox},
	file = {2024 - Chemical Society Reviews - Rafiee Mohammad & Abrams Dylan J. - Cyclic voltammetry and chronoamperometry mechanistic tools for organic electros - Journal Article.pdf:/Users/tai/Zotero/storage/PWW8UZTR/2024 - Chemical Society Reviews - Rafiee Mohammad & Abrams Dylan J. - Cyclic voltammetry and chronoamperometry mechanistic tools for organic electros - Journal Article.pdf:application/pdf},
