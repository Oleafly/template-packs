<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="de-DE">
  <info>
    <title>WBH Numeric</title>
    <id>http://wbh.local/styles/wbh-numeric</id>
    <link href="http://wbh.local/styles/wbh-numeric" rel="self"/>
    <author><name>WBH B-Aufgabe</name></author>
    <category citation-format="numeric"/>
    <category field="generic-base"/>
    <updated>2026-05-11T00:00:00+00:00</updated>
    <summary>Numeric bibliography, full author names in natural order, no "n.d." for missing dates.</summary>
  </info>
  <locale xml:lang="de-DE">
    <terms>
      <term name="and">und</term>
    </terms>
  </locale>
  <citation collapse="citation-number">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout prefix="[" suffix="]" delimiter=", ">
      <text variable="citation-number"/>
    </layout>
  </citation>
  <bibliography entry-spacing="0" second-field-align="flush">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout suffix=".">
      <text variable="citation-number" prefix="[" suffix="]&#160;"/>
      <text variable="note" prefix="(" suffix=")&#160;" font-weight="bold"/>
      <group delimiter=". ">
        <names variable="author">
          <name and="text" delimiter=", " delimiter-precedes-last="never" initialize="false" sort-separator=" "/>
        </names>
        <group delimiter=". ">
          <text variable="title" font-style="italic"/>
          <text variable="container-title" font-style="italic"/>
        </group>
        <text variable="edition"/>
        <group delimiter=": ">
          <text variable="publisher-place"/>
          <text variable="publisher"/>
        </group>
        <date variable="issued">
          <date-part name="year"/>
        </date>
        <text variable="URL"/>
      </group>
    </layout>
  </bibliography>
</style>
