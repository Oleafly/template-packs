}



% ------- 基本宏包和配色 -------
\usepackage{xcolor}
\usepackage{etoolbox} % 用于环境钩子，替代 BeforeBegin/AfterEnd 更稳定
\usepackage{amsmath,amsthm} % 定理环境所需

% 自定义颜色
\definecolor{cugbblue}{rgb}{0,0.427,0.721}       % 地大蓝 (0,109,184)
\definecolor{peking_orange}{cmyk}{0,0.7,1,0}     % 橙色
\definecolor{pantone_gold}{RGB}{135,103,79}      % 金色
\definecolor{cug_red}{RGB}{255,0,0}      % 金色
\definecolor{cug_green}{RGB}{0,255,0}      % 金色
\definecolor{thucolor}{rgb}{0.455,0.204,0.506}  %RGB#82318E

% ------- 样式设置 -------
\setbeamertemplate{blocks}[rounded]

% 默认 block（地大蓝）
\setbeamercolor{block title}{bg=cugbblue,fg=white}
\setbeamercolor{block body}{bg=cugbblue!10}

% alert block（橙色）
\setbeamercolor{block title alerted}{bg=cug_red,fg=white}
\setbeamercolor{block body alerted}{bg=cug_red!10}

% % % example block（金色）
% \setbeamercolor{block title greenexample}{bg=white!70!cug_green,fg=cugbblue}
% \setbeamercolor{block body greenexample}{bg=white!95!cug_green}


% ------- 自定义编号 nalertblock 和 nexampleblock -------
\newcounter{cug@alertcnt}[section]
\newenvironment{nalertblock}[1]{%
  \refstepcounter{cug@alertcnt}%
  \begin{alertblock}{#1\hfill(\arabic{cug@alertcnt})}%
}{\end{alertblock}}

\newcounter{cug@examplecnt}[section]
\newenvironment{nexampleblock}[1]{%
  \refstepcounter{cug@examplecnt}%
  \begin{exampleblock}{#1\hfill(\arabic{cug@examplecnt})}%
}{\end{exampleblock}}

% ------- 定理类定义及配色 -------
\setbeamertemplate{theorems}[numbered]

% 标准定理环境定义
% \newtheorem{definition}{定义}[section]
% \newtheorem{theorem}{定理}[section]
\newtheorem{myproposition}{命题}[section]

% 给每个定理类绑定专属颜色，不影响其它 block
\AtBeginEnvironment{definition}{%
  \setbeamercolor{block title}{bg=cugbblue, fg=white}
  \setbeamercolor{block body}{bg=cugbblue!10}
}
\AfterEndEnvironment{definition}{%
  \setbeamercolor{block title}{bg=cugbblue, fg=white}
  \setbeamercolor{block body}{bg=cugbblue!10}
}

\AtBeginEnvironment{theorem}{%
  \setbeamercolor{block title}{bg=peking_orange, fg=white}
  \setbeamercolor{block body}{bg=peking_orange!10}
}
\AfterEndEnvironment{theorem}{%
  \setbeamercolor{block title}{bg=cugbblue, fg=white}
  \setbeamercolor{block body}{bg=cugbblue!10}
}

\AtBeginEnvironment{myproposition}{%
  \setbeamercolor{block title}{bg=peking_orange, fg=white}
  \setbeamercolor{block body}{bg=peking_orange!10}
}
\AfterEndEnvironment{myproposition}{%
  \setbeamercolor{block title}{bg=cugbblue, fg=white}
  \setbeamercolor{block body}{bg=cugbblue!10}
}

% ------- 自定义彩色 block 环境（无编号） -------

\newenvironment{purple_block}[1]{%
  \setbeamercolor{block title}{bg=thucolor, fg=white}
  \setbeamercolor{block body}{bg=thucolor!10}
  \begin{block}{#1}
}{\end{block}}

\newenvironment{green_block}[1]{%
  \setbeamercolor{block title}{bg=cug_green, fg=black}
  \setbeamercolor{block body}{bg=cug_green!10}
  \begin{block}{#1}
}{\end{block}}

\newenvironment{red_block}[1]{%
  \setbeamercolor{block title}{bg=cug_red, fg=white}
  \setbeamercolor{block body}{bg=cug_red!10}
  \begin{block}{#1}
}{\end{block}}

\newenvironment{gold_block}[1]{%
  \setbeamercolor{block title}{bg=pantone_gold, fg=white}
