#heading(numbering: none, outlined: false)[Abkürzungsverzeichnis] <sec:abkuerzungen>

// TODO: Eigene Abkuerzungen ergaenzen, alphabetisch sortiert.
// Aufgenommen werden nur Abkuerzungen, die im Text tatsaechlich verwendet
// werden. Jede Abkuerzung wird zusaetzlich bei ihrer ersten Nennung im
// Fliesstext ausgeschrieben.

#table(
  columns: (2.6cm, 1fr),
  inset: (x: 0pt, y: 4pt),
  column-gutter: 8pt,
  stroke: none,
  align: (left, left),

  table.header(
    [*Abkürzung*], [*Bedeutung*],
  ),

  [API], [Application Programming Interface (Programmierschnittstelle)],
  [CAD], [Computer-Aided Design (rechnergestützte Konstruktion)],
  [CSV], [Comma-Separated Values (Dateiformat für Messdaten)],
  [GUI], [Graphical User Interface (grafische Benutzeroberfläche)],
  [RMSE], [Root Mean Square Error (Wurzel des mittleren quadratischen Fehlers)],
)
