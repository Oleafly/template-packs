% Bibliografia del corso, in formato BibTeX.
%
% Ogni voce ha una chiave (es. "esempio_libro_2024"): usala per citare nel
% testo con @chiave, oppure elencala in `sources` dentro config.typ per
% farla comparire, formattata per esteso, nella pagina "Prima di
% cominciare". #bibliography("citations.bib") in main.typ stampa l'elenco
% completo in fondo alla dispensa.
%
% Le due voci qui sotto sono di esempio: sostituiscile con la bibliografia
% reale del corso (mantieni le chiavi coerenti con quelle usate in
% config.typ e nel testo).

@book{esempio_libro_2024,
  author    = {Cognome, Nome},
  publisher = {Editore},
  title     = {Titolo del libro di esempio},
  year      = {2024},
}

@article{esempio_articolo_2023,
  author  = {Cognome, Nome and Cognome, Nome},
  journal = {Nome della rivista},
  title   = {Titolo dell'articolo di esempio},
  year    = {2023},
}
