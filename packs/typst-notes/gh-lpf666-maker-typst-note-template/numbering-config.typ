// Central numbering switches for the whole notebook.
// `true` enables chapter-aware numbering; `false` keeps that type unnumbered.
#let numbering-config = (
  equation: true,

  theorem: true,
  lemma: true,
  corollary: true,
  proposition: true,
  problem: true,
  exercise: true,

  note: true,
  definition: true,
  remark: true,
  notation: true,
  example: true,
  concept: true,
  computational-problem: true,
  algorithm: true,
  runtime: true,
)
