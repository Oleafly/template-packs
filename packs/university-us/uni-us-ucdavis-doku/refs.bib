@Article{Carlsson2022,
author={Carlsson, Erik
and Carlsson, John},
title={Topology and Local Optima in Computer Vision},
journal={SN Computer Science},
year={2022},
month={Jan},
day={20},
volume={3},
number={2},
pages={138},
abstract={We present an application of persistent homology to the image correspondence problem, also known as image registration, which is used to produce 3D reconstructions of scenery from two or more cameras. We present a novel filtered complex in the sense of persistent homology, and show that nontrivial homology groups in its persistence diagrams correspond to recognizable anomalies in images pairs, such as repeated patterns, which contribute to non-convexity of the relevant cost function. We present examples with actual image pairs, and prove a basic result that the corresponding homology classes are invariant under certain continuous deformations.},
issn={2661-8907},
doi={10.1007/s42979-021-01003-x},
url={https://doi.org/10.1007/s42979-021-01003-x}
}

