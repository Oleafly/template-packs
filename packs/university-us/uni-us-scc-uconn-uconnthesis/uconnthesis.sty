% Abstract pages are unnumbered, including continuation pages.
\def\ps@uconnabstract{%
  \def\@oddhead{\hfil\@name\ -- University of Connecticut, \@copyrightyear\hfil}%
  \let\@evenhead\@oddhead
  \def\@oddfoot{}\def\@evenfoot{}}
\def\abstractpage{%
  \pagestyle{uconnabstract}\thispagestyle{empty}
  \begin{center}
    \begin{minipage}{.82\textwidth}
      \centering\singlespacing
      {\LARGE\bfseries \@title\par}
    \end{minipage}\par
    \vspace{12mm}
    \singlespacing
    \@name, \@myNewDegreeShort\par
    University of Connecticut, \@copyrightyear\par
    \vspace{12mm}
    {\large\bfseries ABSTRACT\par}
  \end{center}
  \vspace{4mm}
  \doublespacing
}

% A centered title block with deliberate spacing between related groups.
\def\titlepage{%
  \setcounter{page}{1}
  \thispagestyle{empty}
  \vspace*{12mm}
  \begin{center}
    \begin{minipage}{.82\textwidth}
      \centering\singlespacing
      {\LARGE\bfseries \@title\par}
    \end{minipage}\par
    \vspace{20mm}
    {\bfseries \@name\par}
    \vspace{8mm}
    \singlespacing
    \@myPreviousDegreeLong\par
  \end{center}
  \vfill
  \begin{center}
    \singlespacing
    A \@thesistype\par
    Submitted in Partial Fulfillment of the\par
    Requirements for the Degree of\par
    \@degree\par
    at the\par
    University of Connecticut\par
    \vspace{5mm}
    \@copyrightyear\par
  \end{center}
  \clearpage
}

\def\copyrightpage{%
  \begingroup
  \vspace*{\fill}
  \begin{center}
    Copyright \copyright\ \@copyrightyear\ by \@name\par
    All rights reserved.\par
  \end{center}
  \vspace*{\fill}
  \clearpage
  \endgroup
}

% Enable ruled signature spaces for a printed committee copy when needed.
% The default advisory committee page lists names, as in the Registrar sample.
\newif\ifsignaturelines
\signaturelinesfalse
\def\uconnadvisor#1#2{%
  \ifx#2\@undefined
  \else
    \ifsignaturelines
      #1 & \rule{\linewidth}{.4pt} \\
         & #2 \\[3mm]
    \else
      #1 & #2 \\[6mm]
    \fi
  \fi}
\def\signature{%
  \begingroup
  \begin{center}
    {\large\bfseries APPROVAL PAGE\par}
    \vspace{5mm}
    \@degree\ \@thesistype\par
    \vspace{5mm}
    {\Large\bfseries \@title\par}
    \vspace{8mm}
    \singlespacing
    Presented by\par
    \@name, \@myPreviousDegreeShort\par
  \end{center}
  \vfill
  \begin{center}
    \singlespacing
    Approved by\par
    \vspace{8mm}
    \begin{tabular}{@{}r@{\hspace{6mm}}p{77mm}@{}}
      \uconnadvisor{Major Advisor}{\@myMajorAdvisor}
      \uconnadvisor{Co-Major Advisor}{\@myCoAdvisorA}
      \uconnadvisor{Co-Major Advisor}{\@myCoAdvisorB}
      \uconnadvisor{Associate Advisor}{\@myAssociateAdvisorA}
      \uconnadvisor{Associate Advisor}{\@myAssociateAdvisorB}
      \uconnadvisor{Associate Advisor}{\@myAssociateAdvisorC}
      \uconnadvisor{Associate Advisor}{\@myAssociateAdvisorD}
    \end{tabular}
  \end{center}
  \vfill
  \begin{center}
    \singlespacing
    University of Connecticut\par
    \@copyrightyear\par
  \end{center}
  \clearpage
  \endgroup
}

\def\firstpage{
    % Reserve space inside the margins for abstract continuation headers.
    \newgeometry{margin=1in,bottom=1.15in,includehead,headheight=15pt,
      headsep=12pt,footskip=.65in}
    \@ifpackageloaded{hyperref}{\hypersetup{pageanchor=false}}{}
	\pagenumbering{roman}
    \abstractpage
	}

\def\beforepreface{
    \restoregeometry
    \@ifpackageloaded{hyperref}{\hypersetup{pageanchor=true}}{}
	\pagenumbering{roman}
    %\abstractpage
	\pagestyle{plain}
	\begingroup\titlepage\endgroup
	\ifcopyright\copyrightpage\fi
    \signature
	}

\def\prefacesection#1{%
	\chapter*{#1}
	\addcontentsline{toc}{chapter}{#1}}

\def\afterpreface{\newpage
	\renewcommand{\contentsname}{Table of Contents}
	\begingroup\singlespacing
	\tableofcontents
	\newpage
	\iftablespage
		{\addvspace{10pt}
		\let\saveaddvspace=\addvspace
		\def\addvspace##1{}
		\listoftables
		\let\addvspace=\saveaddvspace}
		\newpage
	\fi
	\iffigurespage
		{\addvspace{10pt}
		\let\saveaddvspace=\addvspace
		\def\addvspace##1{}
		\listoffigures
		\let\addvspace=\saveaddvspace}
		\newpage
	\fi

	\endgroup
	\doublespacing
	\pagenumbering{arabic}
	\pagestyle{plain}}


\def\thebibliography#1{\chapter*{References\@mkboth
 {REFERENCES}{REFERENCES}}
	 \addcontentsline{toc}{chapter}{References}
	 \list
	 {[\arabic{enumi}]}{\settowidth\labelwidth{[#1]}\leftmargin\labelwidth
	 \advance\leftmargin\labelsep
	 \usecounter{enumi}}
	 \def\newblock{\hskip .11em plus .33em minus .07em}
	 \sloppy\clubpenalty4000\widowpenalty4000
	 \sfcode`\.=1000\relax}
	\let\endthebibliography=\endlist

% Use bottom-centered page numbers when front matter is omitted.
\pagestyle{plain}
