

% \usepackage[disable]{todonotes}
\usepackage[colorinlistoftodos]{todonotes}

\let\Oldtodo\todo
\renewcommand{\todo}[1]{\Oldtodo[inline]{\textbf{TODO:} #1}}
\newcommand{\tom}[2][]{\Oldtodo[inline,color=SeaGreen, #1]{\textbf{Tom:} #2}}

% Example of a new one
\newcommand{\NEWPERSON}[2][]{\Oldtodo[inline,color=NEWCOLOUR, #1]{\textbf{NEWPERSON:} #2}}
% List of colours here: https://en.wikibooks.org/wiki/LaTeX/Colors#The_68_standard_colors_known_to_dvips

\newcommand{\help}[2][]{\Oldtodo[inline,color=pink, #1]{\textbf{Help requested:} #2}}
\newcommand{\feedback}[2][]{\Oldtodo[inline,color=pink, #1]{\textbf{Feedback requested:} #2}}
\newcommand{\question}[2][]{\Oldtodo[inline,color=pink, #1]{\textbf{Question:} #2}}
\newcommand{\everyone}[2][]{\Oldtodo[inline,color=Purple, #1]{\textbf{Everyone: #2}}}

\newcommand{\needcite}[2][]{\footnote{\Oldtodo[inline, nolist, color=pink, #1]{Needs citation}}}