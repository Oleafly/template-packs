\newcommand{\darkmode}{
    \pagecolor{dark}
    \color{white}
    \hypersetup{linkcolor=yellow,urlcolor=yellow,
                anchorcolor=yellow,citecolor=yellow}
}


\newcommand{\placeholder}[1]{{\color{gray} \lipsum[#1]}}
