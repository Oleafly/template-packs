}

%% Nicer uniform ref
\newcommand{\chap}[1]{Chapter~\ref{chap:#1}}
\newcommand{\appx}[1]{Appendix~\ref{chap:#1}}
\newcommand{\fig}[1]{Fig.~\lref{fig:#1}}
\newcommand{\tbl}[1]{Table~\lref{tbl:#1}}
\newcommand{\sect}[1]{Section~\lref{sec:#1}}
\newcommand{\algo}[1]{Algorithm~\lref{algo:#1}}

%% Chapter headings and reprint footnote
\newcommand{\mybibentry}[1]{\begin{NoHyper}\bibentry{#1}\end{NoHyper}}
\newcommand{\chapreprint}[1]{\footnote{This chapter including figures/tables are reprinted with permission from #1}}
\newcommand{\chapternormal}[1]{\chapter{\texorpdfstring{\uppercase{#1}}{#1}}}
