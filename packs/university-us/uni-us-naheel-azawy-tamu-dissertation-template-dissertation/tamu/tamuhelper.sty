%% wrapper to skip responsehelper
\newcommand{\revcolor}[1]{#1}
\newcommand{\rev}[2]{#2}
\newcommand{\mkresponse}[2]{}

%% local labels and refs
\newcommand{\paperprefix}{}
\newcommand{\llabel}[1]{}
\newcommand{\lref}[1]{}

%% to access each part of the document
\newcommand{\includepart}[1]{
\renewcommand{\paperprefix}{#1}
\renewcommand{\llabel}[1]{\label{\paperprefix-##1}}
\renewcommand{\lref}[1]{\ref{\paperprefix-##1}}
