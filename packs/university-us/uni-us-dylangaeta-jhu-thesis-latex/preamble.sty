% ================================
% PDF/A COMPLIANCE (MUST BE FIRST)
% ================================
% Load xcolor before pdfx for PDF/A compatibility
\usepackage[table,dvipsnames]{xcolor}
\PassOptionsToPackage{utf8}{inputenc}
% Suppress known harmless warnings from pdfx/xcolor interaction:
%   - xcolor: pdfx passes obsolete 'hyperref' option to already-loaded xcolor
%   - pdfx: informational note about enforcing RGB color model for PDF/A-1b
\usepackage{silence}
\WarningFilter{xcolor}{Package option}
\WarningFilter{pdfx}{Setting all color commands to rgb}
\WarningFilter{pdfx}{Color Model}
\usepackage[a-1b]{pdfx}

