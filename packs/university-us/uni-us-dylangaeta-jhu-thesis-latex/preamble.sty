      filecolor=blue,
      urlcolor=blue
  }

% ================================
% TOC / Lists
% ================================
\usepackage{tocbibind}
\usepackage{tocloft}
\setlength{\cftfignumwidth}{6em}
\setlength{\cfttabnumwidth}{6em}

% ================================
% Labels and numbering
% ================================
\renewcommand{\thechapter}{\arabic{chapter}}

\renewcommand{\thefigure}{Figure~\arabic{chapter}.\arabic{figure}}
\captionsetup[figure]{labelformat=simple, labelsep=space, name={}}

\renewcommand{\thetable}{Table~\arabic{chapter}.\arabic{table}}
\captionsetup[table]{labelformat=simple, labelsep=space, name={}}

\renewcommand{\theequation}{Equation~\arabic{chapter}.\arabic{equation}}

