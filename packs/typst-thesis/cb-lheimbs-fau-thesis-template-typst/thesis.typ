// Main thesis document
// Import configuration and styling
#import "config.typ": *
#import "lib.typ": *
#import "@preview/glossarium:0.5.10": gls, glspl, make-glossary, print-glossary, register-glossary

// Set document metadata
#set document(
  title: thesis-title,
  author: thesis-author-given-name + " " + thesis-author-surname,
  date: thesis-submission-date,
)

// Initialize glossarium (must come before thesis-template)
#show: make-glossary
#register-glossary(glossary-entry-list)

// Apply thesis styling
#show: thesis-template.with(
  title: thesis-title,
  author-given-name: thesis-author-given-name,
  author-surname: thesis-author-surname,
  submission-date: thesis-submission-date,
  submission-city: thesis-submission-city,
  thesis-type: thesis-type,
  supervisors: thesis-supervisors,
  language: thesis-language,
  bibliography-file: "mybibliography.bib",
)

// Title page is generated by the template
// (Title page + blank page from template)

// Declaration of Originality and License on same page (page i - should be odd)
#if thesis-language == "German" [
  #chapter(numbering: none, outlined: false)[Eidesstattliche Erklärung]
  #label("ch:eidesstattliche_erklaerung")

  Ich versichere, dass ich die Arbeit ohne fremde Hilfe und ohne Benutzung anderer als der angegebenen Quellen angefertigt habe und dass die Arbeit in gleicher oder ähnlicher Form noch keiner anderen Prüfungsbehörde vorgelegen hat und von dieser als Teil einer Prüfungsleistung angenommen wurde.
  Alle Ausführungen, die wörtlich oder sinngemäß übernommen wurden, sind als solche gekennzeichnet.
] else [
  #chapter(numbering: none, outlined: false)[Declaration of Originality]
  #label("ch:declaration_of_originality")

  I confirm that the submitted thesis is original work and was written by me without further assistance.
  Appropriate credit has been given where reference has been made to the work of others.
  The thesis was not examined before, nor has it been published.
  The submitted electronic version of the thesis matches the printed version.
]

#v(0.5in)
#line(length: 3in, stroke: 0.5pt)
#thesis-submission-city, #thesis-submission-date.display("[day].[month].[year]")

// License on same page
#if thesis-language == "German" [
  #chapter(numbering: none, outlined: false)[Lizenz]
  #label("ch:lizenz")

  Diese Arbeit unterliegt der Creative Commons Attribution 4.0 International Lizenz (CC BY 4.0), #link("https://creativecommons.org/licenses/by/4.0/")
] else [
  #chapter(numbering: none, outlined: false)[License]
  #label("ch:license")

  This work is licensed under the Creative Commons Attribution 4.0 International license (CC BY 4.0), see #link("https://creativecommons.org/licenses/by/4.0/")
]

#v(0.5in)
#line(length: 3in, stroke: 0.5pt)
#thesis-submission-city, #thesis-submission-date.display("[day].[month].[year]")

// Empty page after Declaration/License (page ii blank), then start Abstract on page iii
#pagebreak(to: "odd")

// Abstract on page iii
#chapter(numbering: none, outlined: false)[Abstract]
#label("chapter:abstract")
#include "contents/abstract.typ"

// Zusammenfassung (German summary, only if thesis is in German)
#if thesis-language == "German" [
  #pagebreak()
  #chapter(numbering: none, outlined: false)[Zusammenfassung]
  #label("chapter:zusammenfassung")
  #include "contents/zusammenfassung.typ"
]

// Empty page after abstract (page iv blank), then TOC starts on page v
#pagebreak(to: "odd")

// Table of Contents - styled to match LaTeX template
// Override level 1 entries: add dot leaders, remove bold/extra spacing
#{
  show outline.entry.where(level: 1): it => context {
    let loc = it.element.location()
    if it.element.numbering == "A.1" {
      // Appendix sub-entries: indented with dot leaders
      link(loc)[
        #block(above: 1em)[
          #h(1.5em)
          #it.prefix() #h(1em) #it.body()
          #box(width: 1fr, repeat([.], gap: 2pt))
          #it.page()
        ]
      ]
    } else {
      // Chapter entries: no dot leaders, right-aligned page number
      link(loc)[
        #block(above: 1.5em)[
          *#it.prefix() #it.body()*
          #h(1fr)
          *#it.page()*
        ]
      ]
    }
  }

  outline(
    title: if thesis-language == "German" [Inhaltsverzeichnis] else [Contents],
    indent: auto,
  )
}

// Empty page after TOC
#pagebreak(to: "odd")

// List of Figures
#{
  show outline.entry.where(level: 1): set outline.entry(fill: repeat([.], gap: 4.5pt))
  show outline.entry.where(level: 1): set block(above: 0.65em)

  outline(
    title: if thesis-language == "German" [Abbildungsverzeichnis] else [List of Figures],
    target: figure.where(kind: image),
  )
}

// Empty page after List of Figures
#pagebreak(to: "odd")

// List of Tables
#{
  show outline.entry.where(level: 1): set outline.entry(fill: repeat([.], gap: 4.5pt))
  show outline.entry.where(level: 1): set block(above: 0.65em)

  outline(
    title: if thesis-language == "German" [Tabellenverzeichnis] else [List of Tables],
    target: figure.where(kind: table),
  )
}

// Empty page after List of Tables
#pagebreak(to: "odd")

// Acronyms
#include "contents/acronyms.typ"

// Empty page after Acronyms, then content starts on page 1
#pagebreak(to: "odd")

// MAIN CONTENT SECTION
// Switch to Arabic numbering and enable headers
#set page(numbering: "1")
#counter(page).update(1)
#in-main-content.update(true)

// Enable chapter numbering for main content
#set heading(numbering: "1.1")

// TODO: replace example.typ with your actual content chapters.
#include "contents/example.typ"

// APPENDICES (scoped so appendix styling doesn't affect bibliography)
#{
  show: appendix-style
  include "contents/appendices.typ"
}

// Reset appendix state for bibliography
#in-appendix.update(false)
#header-visible.update(true)

// BIBLIOGRAPHY
#pagebreak()
#if thesis-language == "German" [
  #heading(numbering: none, outlined: true)[Literaturverzeichnis]
] else [
  #heading(numbering: none, outlined: true)[References]
]

#bibliography("mybibliography.bib", style: "apa", title: none)
