    [16 核], [4.73×10⁻³], [3.91×10⁻⁵], [99.2%],
    [32 核], [2.85×10⁻²], [5.86×10⁻⁵], [99.8%],
    [64 核], [1.36×10⁻¹], [3.91×10⁻⁵], [99.97%],
