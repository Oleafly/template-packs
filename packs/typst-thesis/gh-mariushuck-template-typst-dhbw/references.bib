% =====================================================================
% references.bib — Bibliografie der Arbeit
%
% Von Hand gepflegt. Ein Eintrag je Quelle, Citation Key = das, was im
% Text nach dem @ steht: @mustermann2024buch[S. 42].
%
% Die drei Einträge unten sind Beispiele für die häufigsten Typen und
% werden durch die eigenen Quellen ersetzt. Tinymist und andere
% Typst-Erweiterungen vervollständigen die Keys nach dem @.
%
% EINZELVORGABEN DER DHBW ZUM LITERATURVERZEICHNIS:
%   - Der Verlag wird aufgeführt (betrifft Bücher: `publisher`).
%   - Akademische Titel werden nicht angeführt ("Prof. Dr." weglassen).
%   - Die ISBN wird nicht angegeben. Ein `isbn`-Feld darf stehen bleiben,
%     der IEEE-Stil von Typst gibt es nicht aus — vor der Abgabe im PDF
%     nachsehen, falls der Stil gewechselt wurde.
%   - DOI ergänzen, wo vorhanden. Alle anderen digitalen Quellen als PDF
%     in die Beigaben ("Elektronische Quellen").
%   - Internetquellen dürfen ein eigenes Unterkapitel des
%     Literaturverzeichnisses bilden.
%
% DECKUNGSGLEICHHEIT: `bibliography(..., full: false)` in main.typ gibt nur
% zitierte Quellen aus — eine unzitierte Quelle fällt also nicht auf.
% Vor der Abgabe umgekehrt prüfen: steht hier etwas, das im Text nicht
% vorkommt, gehört es heraus.
% =====================================================================

% ---------------------------------------------------------------------
% Buch — Verlag ist Pflicht
% ---------------------------------------------------------------------
@book{mustermann2024buch,
  author    = {Mustermann, Erika and Beispiel, Hans},
  title     = {Titel des Buches: Untertitel},
  edition   = {3},
  year      = {2024},
  publisher = {Beispiel Verlag},
  address   = {München},
}

% ---------------------------------------------------------------------
% Zeitschriftenaufsatz — DOI ergänzen, wo vorhanden
% ---------------------------------------------------------------------
@article{beispiel2023artikel,
  author  = {Beispiel, Anna and Muster, Peter},
  title   = {Titel des Aufsatzes},
  journal = {Name der Zeitschrift},
  volume  = {17},
  number  = {4},
  pages   = {211--230},
  year    = {2023},
  doi     = {10.0000/beispiel.2023.211},
}

% ---------------------------------------------------------------------
% Internetquelle — mit Abrufdatum (urldate)
% ---------------------------------------------------------------------
@online{beispielorg2025online,
  author  = {{Beispielorganisation e. V.}},
  title   = {Titel der Webseite},
  year    = {2025},
  url     = {https://www.example.org/seite},
  urldate = {2026-08-14},
}
