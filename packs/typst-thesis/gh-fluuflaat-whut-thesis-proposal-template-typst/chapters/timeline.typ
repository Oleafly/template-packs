// 对应 LaTeX 版 chapters/timeline.tex
//
// ============================================================
//                    表格语法详解
// ============================================================
//
// 【基本表格】
//   #table(
//     columns: (列1宽, 列2宽, ...),  // 列宽定义
//     [单元格], [单元格],              // 每行数据用 [...] 包裹
//     [单元格], [单元格],
//   )
//
// 【列宽选项】
//   auto     — 根据内容自动调整
//   1fr      — 按比例填充剩余空间（类似 flex: 1）
//   5cm      — 固定宽度
//   30%      — 百分比宽度
//   (1fr, 2fr) — 第二列是第一列的两倍宽
//
// 【对齐方式】
//   align: (center, left)  — 第一列居中，第二列左对齐
//   align: center          — 所有列居中
//
// 【三线表（学术论文常用）】
//   stroke: none,                        // 先去掉所有边框
//   table.hline(stroke: 1.5pt),          // 顶部粗线
//   table.header([*表头1*], [*表头2*]),   // 表头行（加粗）
//   table.hline(stroke: 0.75pt),         // 表头下方细线
//   [...数据行...],
//   table.hline(stroke: 1.5pt),          // 底部粗线
//
// 【带完整边框的表格】
//   #table(
//     columns: (1fr, 1fr),
//     stroke: 0.5pt,            // 所有单元格都有 0.5pt 边框
//     [单元格1], [单元格2],
//     [单元格3], [单元格4],
//   )
//
// 【合并单元格】
//   table.cell(colspan: 2)[跨两列的内容]   — 合并列
//   table.cell(rowspan: 2)[跨两行的内容]   — 合并行
//
// 【给表格加标题】
//   用 #figure(..., kind: table) 包裹，并加 caption:
//   #figure(
//     table(...),
//     caption: [表格标题],
//     kind: table,
//   ) <tab:label>   // 可选标签，用 @tab:label 引用
//
// ============================================================

#import "../template.typ": font-size

= 时间进度安排

以下为本课题的时间进度安排。

#figure(
  table(
    columns: (auto, 1fr),
    align: (center, left),
    stroke: none,
    // 表头
    table.hline(stroke: 1.5pt),
    table.header(
      [*起止时间*], [*主要内容*],
    ),
    table.hline(stroke: 0.75pt),
    // 数据行——修改下面的内容即可
    [2024.12 - 2025.02], [查阅文献，完成开题报告……],
    [2025.03 - 2025.03], [系统设计与环境准备……],
    [2025.04 - 2025.04], [模型训练与实验验证……],
    [2025.05 - 2025.05], [系统联调与优化……],
    [2025.05 - 2025.06], [论文撰写与答辩准备……],
    // 如需增加行，直接在这里添加：
    // [2025.06 - 2025.07], [新阶段内容……],
    table.hline(stroke: 1.5pt),
  ),
  kind: table,
)
