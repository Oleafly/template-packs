#import "../skripsi.typ": *
#import "../metadata.typ": *

#halaman-abstrak(
  label: "ABSTRAK",
  penulis: penulis,
  nim: nim,
  program-studi-label: "Program Studi " + program-studi,
  pembimbing-label: "Dosen Pembimbing",
  pembimbing1: pembimbing1,
  pembimbing2: pembimbing2,
  judul: judul,
  isi: [
    Abstrak ditulis dalam Bahasa Indonesia dan Bahasa Inggris. Abstrak terdiri atas 7 (tujuh) bagian pokok yaitu: latar belakang (1-5 baris); tujuan penelitian (1-2 baris); metode yang digunakan (1-3 baris); data yang digunakan (1-2 baris); hasil percobaan yang menjadi kekhasan penelitian (1-7 baris); hasil analisa (1-7 baris); efek/impak dari hasil analisa (1-3 baris).

    (Abstrak diketik dalam 1 spasi)

    #catatan[
      1. Minimal 200 kata, dan maksimal 300 kata (satu halaman saja).
      2. Minimal 3 kata kunci, dan maksimal 5 kata kunci.
      3. Isi abstrak adalah:
         - a. Latar belakang secara singkat.
         - b. Kegiatan dalam penyusunan skripsi, termasuk proses dan analisis.
         - c. Hasil yang paling utama.
      4. Perlu disampaikan sumbangan mandiri yang dapat ditonjolkan dalam skripsi.
    ]
  ],
  kata-kunci-label: "Kata kunci",
  kata-kunci: [Kata kunci 1, Kata kunci 2, Kata kunci 3, Kata kunci 4, Kata kunci 5],
)
