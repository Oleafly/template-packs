// ═══════════════════════════════════════════════════════════════════════════
// THEME — colours, fonts and page geometry
// ═══════════════════════════════════════════════════════════════════════════
//
// You normally do NOT edit this file. Everything below can be overridden from
// `config.typ` by passing a `theme: (...)` dictionary, e.g.
//
//     theme: (accent: rgb("#8a1538"), font-size: 11pt)
//
// Only the keys you list are changed; the rest keep the defaults below.
// Edit this file only if you want to change the defaults for everyone who
// clones your copy of the template.

#let default-theme = (
  // ── Colours ────────────────────────────────────────────────────────────
  accent: rgb(0, 51, 102), // headings, links, rules, box accents
  accent-bg: auto, // note-box background; `auto` ⇒ accent lightened by 78 %
  underline: rgb(0, 169, 224), // colour of the rule under the cover title
  text-muted: rgb("#303030"), // header / footer, secondary text

  // ── Font stacks ────────────────────────────────────────────────────────
  // The three families below ship WITH Typst, so the document compiles
  // identically on every machine and in CI without installing anything.
  // Replace them with e.g. ("Arial",) if your faculty prescribes a font —
  // but then everyone compiling the thesis needs that font installed.
  font-serif: ("Libertinus Serif",), // body text
  font-sans: ("New Computer Modern",), // headings, captions, header/footer
  font-mono: ("DejaVu Sans Mono",), // code

  // ── Page & body ────────────────────────────────────────────────────────
  paper: "a4",
  // `inside` is the margin at the binding, `outside` the one at the open edge.
  // With `two-sided: true` (see config.typ) they swap on every other page.
  margin: (inside: 3cm, outside: 2.5cm, top: 2.5cm, bottom: 2.5cm),
  font-size: 11pt,
  leading: 0.75em, // space between lines within a paragraph
  spacing: 1.2em, // space between paragraphs
  lang: "en", // affects hyphenation and words like "Figure"
  region: "gb", // "gb" ⇒ British, "us" ⇒ American conventions

  // ── Headings ───────────────────────────────────────────────────────────
  // Font size of levels 1..4, as a multiple of the body font size.
  heading-sizes: (1.8em, 1.4em, 1.2em, 1.0em),
  heading-numbering: "1.1", // ⇒ "1", "1.1", "1.1.1"; use none to switch off
)

// Merge the user's overrides onto the defaults and derive `accent-bg` from
// `accent` when it was left at `auto`.
#let resolve-theme(overrides) = {
  let t = default-theme
  if overrides != none { t = t + overrides }
  if t.accent-bg == auto { t.accent-bg = t.accent.lighten(78%) }
  t
}

// The active theme, published as document state so that helpers which are
// called from inside the text (e.g. `note` in lib/blocks.typ) can pick up the
// colours without every call site passing them along. `thesis()` fills it in.
#let theme-state = state("thesis-theme", default-theme)
