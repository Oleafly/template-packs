<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" default-locale="ru-RU">
  <info>
    <title>GOST R 7.0.5-2008 (Custom with Em-Dashes)</title>
    <id>http://www.zotero.org/styles/gost-r-7-0-5-2008-custom-dashes</id>
    <link href="http://www.zotero.org/styles/gost-r-7-0-5-2008-custom-dashes" rel="self"/>
    <author>
      <name>Custom Fix</name>
    </author>
    <category citation-format="numeric"/>
    <category field="generic-base"/>
    <summary>Custom GOST R 7.0.5-2008 style with explicit em-dash separators and correct symbology.</summary>
    <updated>2026-03-26T10:00:00+00:00</updated>
  </info>

  <locale xml:lang="ru">
    <terms>
      <term name="et-al"> и др.</term>
      <term name="editor" form="verb">под ред.</term>
      <term name="accessed">дата обращения</term>
    </terms>
  </locale>

  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=" " initialize-with=". " delimiter=", " delimiter-precedes-last="always"/>
      <label form="short" prefix=" "/>
    </names>
  </macro>

  <macro name="title">
    <choose>
      <if type="book webpage" match="any">
        <text variable="title"/>
      </if>
      <else>
        <text variable="title"/>
      </else>
    </choose>
  </macro>

  <macro name="container">
    <choose>
      <if type="article-journal article-magazine article-newspaper" match="any">
        <text variable="container-title" form="short"/>
      </if>
      <else-if type="chapter paper-conference" match="any">
        <text variable="container-title"/>
      </else-if>
    </choose>
  </macro>

  <macro name="publisher">
    <group delimiter=": ">
      <text variable="publisher-place"/>
      <text variable="publisher"/>
    </group>
  </macro>

  <macro name="year-date">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="locators">
    <choose>
      <if type="article-journal">
        <group delimiter=". — ">
          <text variable="volume" prefix="Т. "/>
          <text variable="issue" prefix="№ "/>
          <text variable="page" prefix="С. "/>
        </group>
      </if>
      <else-if type="book">
        <text variable="number-of-pages" suffix=" с."/>
      </else-if>
      <else-if type="chapter paper-conference" match="any">
        <text variable="page" prefix="С. "/>
      </else-if>
    </choose>
  </macro>

  <macro name="access">
    <choose>
      <if variable="URL">
        <group delimiter=" ">
          <text value="URL:"/>
          <text variable="URL"/>
          <group prefix="(" suffix=")">
            <text term="accessed" suffix=": "/>
            <date variable="accessed">
              <date-part name="day" form="numeric-leading-zeros" suffix="."/>
              <date-part name="month" form="numeric-leading-zeros" suffix="."/>
              <date-part name="year"/>
            </date>
          </group>
        </group>
      </if>
    </choose>
  </macro>

  <citation collapse="citation-number">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout prefix="[" suffix="]" delimiter=", ">
      <text variable="citation-number"/>
      <group prefix=", ">
        <label variable="locator" form="short" suffix=" "/>
        <text variable="locator"/>
      </group>
    </layout>
  </citation>

  <bibliography et-al-min="4" et-al-use-first="3" entry-spacing="0" second-field-align="flush">
    <layout suffix=".">
      <text variable="citation-number" suffix=". "/>
      <group delimiter=". — ">
        <group>
          <text macro="author" suffix=" "/>
          <text macro="title"/>
          <text macro="container" prefix=" // "/>
        </group>
        <group delimiter=", ">
          <text macro="publisher"/>
          <text macro="year-date"/>
        </group>
        <text macro="locators"/>
        <text macro="access"/>
      </group>
    </layout>
  </bibliography>
</style>
