/// ========================================
/// Typst 中文简历模板 - 示例简历
/// ========================================

/// 导入模板文件中的所有函数和样式
#import "template.typ": *

/// ========================================
/// 主题颜色配置
/// ========================================
/// 深蓝色主题，用于标题、图标等元素
#let theme-color = rgb("#254665")
/// 创建使用主题颜色的图标函数
#let icon = icon.with(fill: theme-color)

/// ========================================
/// 图标配置
/// ========================================
/// 从 FontAwesome 导入需要的图标
/// 来源: https://fontawesome.com/icons/
#let fa-award = icon("icons/fa-award.svg")           // 奖杯图标（荣誉）
#let fa-building-columns = icon("icons/fa-building-columns.svg")  // 大楼图标（自我评价）
#let fa-code = icon("icons/fa-code.svg")                // 代码图标（实践经历）
#let fa-envelope = icon("icons/fa-envelope.svg")         // 信封图标（联系方式）
#let fa-graduation-cap = icon("icons/fa-graduation-cap.svg") // 学士帽图标（教育背景）

/// ========================================
/// 定义全局侧边栏内容
/// ========================================
/// 侧边栏显示在左侧深蓝色背景区域
/// 包含头像、姓名、基本资料、技能水平、兴趣特长等
#let my-sidebar = [
  /// 头像（圆形裁剪 + 白色边框）
  #align(center)[
    #box(
      width: 11.5em,          // 头像宽度
      height: 11.5em,         // 头像高度
      radius: 50%,             // 圆形裁剪
      stroke: 0.2em + white,  // 白色边框
      clip: true,              // 裁剪超出部分
      image("profile.png", width: 100%, height: 100%, fit: "cover"),  // 填充裁剪
    )
  ]
  #v(1.2em)  // 头像下方的垂直间距

  /// 姓名（大字居中）
  #align(center)[
    #text(size: 2.5em, weight: "bold")[张某某]
  ]
  #v(1.5em)  // 姓名下方的垂直间距

  /// 基本资料
  === #text(size: 1.2em)[▶]#h(0.3em)基本资料
  籍贯：某某省某某市 \
  手机：138-xxxx-xxxx \
  邮箱：xxx\@example.com \
  出生日期：2000.xx.xx \
  政治面貌：群众

  /// 技能水平
  === #text(size: 1.2em)[▶]#h(0.3em)技能水平
  ✓ *专业技能* \
  #h(1em) 熟练使用专业软件工具 \
  #h(1em) 熟练使用数据分析软件 \
  #h(1em) 熟悉使用相关数据库

  ✓ *实践技能* \
  #h(1em) 可以出色完成项目开发与实施 \
  #h(1em) 具备基础实验/开发技能 \
  #h(1em) 熟练项目流程和管理

  /// 兴趣特长
  === #text(size: 1.2em)[▶]#h(0.3em)兴趣特长
  ✓ 技术学习和创新 \
  ✓ 运动和健康 \
  ✓ 创意设计
]

/// ========================================
/// 设置简历选项
/// ========================================
/// 使用 resume 函数配置并生成简历
#show: resume.with(
  /// 字体和基准大小
  size: 10pt,
  /// 标题颜色
  theme-color: theme-color,
  /// 页面边距
  margin: (
    top: 1cm,
    bottom: 1cm,
    left: 0cm,
    right: 1cm,
  ),

  /// 全局侧边栏设置
  global-sidebar: my-sidebar,      // 侧边栏内容
  global-sidebar-width: 30%,       // 侧边栏宽度占页面 30%

  /// 头部居中显示
  header-center: true,
)[
][  /// 空的头部和简介内容（全部在侧边栏显示）
]


/// ========================================
/// 教育背景
/// ========================================
== #fa-graduation-cap 教育背景

/// 教育信息卡片（浅蓝色背景）
#block(
  fill: rgb("#D5DCE4"),           // 浅蓝色背景
  width: 100%,
  inset: (x: 0.8em, y: 0.5em),   // 内边距
  radius: 0.2em,                 // 圆角
  grid(
    columns: (auto, auto, auto, 1fr),  // 四列布局
    gutter: 1.5em,
    [*某某大学*], [*某某专业*], [*本科*], align(right)[*2019.09-至今*],
  ),
)

/// 绩点和排名信息
绩点：3.xx/5.00 #h(2em) 专业排名：xx/xx #h(1em) #text(fill: theme-color)[(本专业前xx%有保研资格)]

*主修课程：*

某某课程(9x)、某某课程(9x)、某某课程(9x)、某某课程(8x)、综合实验(9x)、基础实践(9x)、高级实践(9x)

*证书情况：*

#grid(
  columns: (1fr, 1fr),
  gutter: 1em,
  [英语四级：5xx], [英语六级：5xx],
  [计算机等级：合格], [专业技能证书：合格],
)


