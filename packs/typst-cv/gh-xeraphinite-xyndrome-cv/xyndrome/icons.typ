/// Unified icon creation system for the Xyndrome CV template
/// Creates consistent SVG-based icons with configurable parameters

/// Generic icon creator function that all specific icons should use
#let create-icon(
  svg-data,
  color: black,
  height: 1em,
  baseline: 13.5%,
  inset: (left: 0pt, right: 2pt, top: 0pt, bottom: 0pt),
  outset: (left: 0pt, right: 0pt, top: 0pt, bottom: 0pt),
) = {
  let processed-svg = svg-data.replace("currentColor", color.to-hex())
  box(
    height: height,
    baseline: baseline,
    inset: inset,
    outset: outset,
    image(bytes(processed-svg)),
  )
}

