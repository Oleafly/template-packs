#import "toml.typ": *


#let _config = state("concolor-verus-config", none)
#let _get-config() = {
    let config = _config.get()
    if config == none {
        panic("No configuration found. Did you do `#show: cv-init`?")
    }

    config
}

/// Initialize concolor-verus.
///
/// This should be called at the beginning of the document (before using any other functions):
///
/// ```typst
/// #show: cv-init
/// ```
///
/// It can also be used to configure the theme for the rest of the document:
///
/// ```typst
/// #show: cv-init.with(aside-width: 2cm, section-fill: orange)
/// ```
///
/// -> content
#let cv-init(
    /// The text size of the title.
    ///
    /// This is only used for the default title generated by @cv.
    /// -> length
    title-name-size: 3em,
    /// The paragraph spacing between CV entries.
    /// -> length
    entry-spacing: 1em,
    /// The text size of the header of each CV entry.
    ///
    /// See @entry for more information on the header.
    /// -> length
    entry-header-size: 1em,
    /// The width of the aside.
    ///
    /// The aside contains additional information accompanying each CV entry. It acts like a
    /// left-side margin for the main body of each entry.
    /// -> length
    aside-width: 3cm,
    /// The gutter of the aside.
    ///
    /// This is the separator between the aside and the main body of each CV entry.
    /// -> length
    aside-gutter: 0.4cm,
    /// The text size of the aside.
    /// -> length
    aside-size: 0.8em,
    /// The spacing above each CV section.
    /// -> length
    section-above: 1.5em,
    /// The spacing below each CV section.
    /// -> length
    section-below: 2em,
    /// The fill for each CV section title.
    /// -> color
    section-fill: rgb(50, 160, 115),
    /// The stroke for each CV section header.
    ///
    /// For top-level (level 1) sections, a line is displayed on the aside. If the `paint` of the
    /// line's stroke is set to `auto`, @cv-init.section-fill is used.
    section-line-stroke: (paint: auto, thickness: 0.4em),
    /// The rest of the document.
    /// -> content
    body
) = {
    _config.update(_ => (
        title-name-size: title-name-size,
        entry-spacing: entry-spacing,
        entry-header-size: entry-header-size,
        aside-width: aside-width,
        aside-gutter: aside-gutter,
        aside-size: aside-size,
        section-above: section-above,
        section-below: section-below,
        section-fill: section-fill,
        section-line-stroke: section-line-stroke,
    ))
    body
}


/// A CV entry.
///
/// An entry is the _atom_ (or building block) of the CV. For instance, in the context of
/// professional experience, an entry corresponds to a single position held at a specific
/// institution during a period of time (e.g., "software engineer at `<company>`").
///
/// #example(
///     ```
///     #show: cv-init
///
///     #entry(
///         title: "Software Engineer",
///         institution: "Some Company",
///         location: "Some City",
///         aside: [Jan 2023--present],
///     )[
///          I am in charge of X, Y, and Z.
///     ]
///     ```,
///     scale-preview: 100%,
///     dir: ttb,
/// )
///
/// CV entries can also be "plain text", which is useful in certain contexts (e.g., when listing
/// references):
///
/// #example(
///     ```
///     #show: cv-init
///
///     #entry[
///         - Reference One (#link("mailto:reference.one@example.com"))
///         - Reference Two (#link("mailto:reference.two@example.com"))
///     ]
///     ```,
///     scale-preview: 100%,
///     dir: ttb,
/// )
///
/// -> content
#let entry(
    /// The title of the CV entry.
    ///
    /// This is most often the title of the degree or job corresponding to the entry.
    /// -> none | string | content
    title: none,
    /// The institution corresponding to the CV entry.
    ///
    /// By default, this is placed under `emph()`. You can override it by applying it a second time:
    ///
    /// #example(
    ///     ```
    ///     #show: cv-init
    ///
    ///     #entry(
    ///         title: "Foo",
    ///         institution: emph("Not Italicized"),
    ///     )[Bar]
    ///     ```,
    ///     scale-preview: 100%,
    /// )
    /// -> none | string | content
    institution: none,
    /// The location corresponding to the CV entry.
    ///
    /// This is the physical location of @entry.institution.
    /// -> none | string | content
    location: none,
    /// An aside to the CV entry.
    ///
    /// This is used to provide additional information for the entry, such as dates.
    /// -> none | string | content
    aside: none,
    /// The main body of the CV entry.
    /// -> content
    body
) = context {
    let config = _get-config()

    block(
        breakable: false,
        {
            let main = {
                set par(spacing: config.entry-spacing)
                let header = (
                    ..if title != none { (strong(title),) },
                    ..if institution != none { (emph(institution),) },
                    ..if location != none { (location,) },
                )

                if header.len() > 0 {
                    text(size: config.entry-header-size, header.join(", "))
                }

                {
                    set par(justify: true)
                    body
                }
            }

            let grid-columns = (
                ..if aside != none { (config.aside-width,) },
                1fr,
            )
            let grid-elements = (
                ..if aside != none {
                    (text(size: config.aside-size, aside),)
                },
                main,
            )

            grid(
                columns: grid-columns,
                column-gutter: config.aside-gutter,
                ..grid-elements,
            )
        }
    )
}


/// A CV section.
///
/// A section is a logical grouping of one or more CV entries (see @entry). For instance, most CVs
/// will have at least two sections: a "professional experience" equivalent and an "education"
/// equivalent:
///
/// #example(
///     ```
///     #show: cv-init
///
///     #section(
///         title: "Professional Experience",
///         entries: (
///             entry(
///                 title: "Job Title",
///                 institution: "Some Company",
///                 location: "Some City",
///                 aside: [Jan 2023--present],
///             )[
///                 Job description goes here...
///             ],
///         ),
///     )
///
///     #section(
///         title: "Education",
///         entries: (
///             entry(
///                 title: "Degree Title",
///                 institution: "Some University",
///                 location: "Some City",
///                 aside: [Sep 2017--Sep 2022],
///             )[
///                 Degree description goes here...
///             ],
///         ),
///     )
///     ```,
///     scale-preview: 100%,
///     dir: ttb,
/// )
///
/// CV sections can contain _other_ CV sections (which are sub-sections):
///
/// #example(
///     ```
///     #show: cv-init
///
///     #section(
///         title: "Education",
///         entries: (
///             entry(
///                 title: "Degree Title",
///                 institution: "Some University",
///                 location: "Some City",
///                 aside: [Sep 2017--Sep 2022],
///             )[
///                 Degree description goes here...
///             ],
///             section(
///                 // This level corresponds to the equivalent of Typst's `heading()`.
///                 level: 2,
///                 title: "Personal Experience",
///                 entries: (
///                     entry(
///                         aside: "Programming",
///                     )[
///                         I won first place at competition X,
///                         and participated in the Y hackathon (2022).
///                     ],
///                 ),
///             )
///         ),
///     )
///     ```,
///     scale-preview: 100%,
///     dir: ttb,
/// )
///
/// -> content
#let section(
    /// The title of the CV section.
    /// -> none | string | content
    title: none,
    /// The CV entries associated with the CV section.
    /// -> array
    entries: (),
    /// The level (or sub-section depth) of the CV section.
    ///
    /// This is the equivalent of the level of Typst's `heading()`.
    /// -> int
    level: 1,
    /// Whether the CV section should break across pages.
    ///
    /// This is equivalent to the `breakable` option of Typst's `block()`. It can be set to `false`
    /// to force a CV section to stay in one page.
    /// -> bool
    breakable: true,
) = context {
    assert(title != none, message: "CV section should have a title")
    let config = _get-config()

    let section-line-stroke = (
        ..config.section-line-stroke,
        paint: if config.section-line-stroke.paint == auto {
            config.section-fill
        } else {
            config.section-line-stroke.paint
        },
    )

    block(
        breakable: breakable,
        above: if level == 1 {
            0em
        } else {
            config.section-above
        },
        below: config.section-below,
        {
            {
                show heading: set text(fill: config.section-fill)
                set align(horizon)

                grid(
                    columns: (config.aside-width, 1fr),
                    column-gutter: config.aside-gutter,
                    if level == 1 {
                        line(length: 100%, stroke: section-line-stroke)
                    },
                    heading(title, level: level),
                )
            }

            entries.join()
        }
    )
}

#let _default-header(name: none, email: none, homepage: none) = context {
    let config = _get-config()

    grid(
        columns: (1fr, auto),
        {
            text(strong(name), size: config.title-name-size)
            linebreak()
            v(0.2em)
            "Curriculum Vitae"
        },
        {
            set align(left)
            set list(marker: ">", body-indent: 0.2em)
            if email != none { list.item(email) }
            if homepage != none { list.item(homepage) }
        },
    )
}

#let _default-footer(name: none, email: none, homepage: none) = {
    grid(
        columns: (1fr, auto),
        align(left, {
            name
            " "
            sym.dash.en
            " Curriculum Vitae"
        }),
        align(right, context counter(page).display("1/1", both: true)),
    )
}


/// Create a full CV document.
///
/// This function provides an alternative to writing Typst code using @section and @entry. Instead,
/// it parses a #link("https://toml.io/en/", text(fill: blue, underline("TOML"))) source which
/// defines the data of the CV, and lays out the entire CV automatically. The parsing is done by
/// @parse-cv-data.
///
/// It is strongly advised to keep the TOML data in a separate (`.toml`) file. For the sake of
/// simplicity, this example combines the TOML data and Typst code:
///
/// #example(
///     ```
///     #show: cv-init
///
///     #let data = "
///     name = \"John Doe\"
///     email = \"john.doe@example.com\"
///     homepage = \"example.com\"
///
///     [[sections]]
///     title = \"Professional Experience\"
///     [[sections.entries]]
///     title = \"Job Title\"
///     institution = \"Some Company\"
///     location = \"Some City\"
///     aside = \"Jan 2023--present\"
///     body = \"\"\"
///     Job description goes here... and Typst code _is_ *supported*! $x^3 + y^3 = z^3$
///
///     Shoot me an email at: #CTX.email
///     \"\"\"
///     [[sections.entries]]
///     title = \"Subsection\"
///     [[sections.entries.entries]]
///     aside = \"Subsection aside\"
///     body = \"Subsection entry\"
///     "
///
///     #cv(
///         // See the `full-document` parameter;
///         // we have to disable it here,
///         // as this example is not at the top level,
///         // and cannot build a full document.
///         // You can set this to `true` (or omit it) in your code.
///         full-document: false,
///         bytes(data),
///     )
///     ```,
///     scale-preview: 100%,
///     dir: ttb,
/// )
///
/// As shown in the example, every TOML string is parsed and evaluated as Typst
/// markup/code. Additionally, the variable `CTX` is accessible in every string, containing the
/// top-level data of the CV (`name`, `email`, and `homepage`).
///
/// -> content
#let cv(
    /// The function to use to lay out CV entries.
    ///
    /// See @entry.
    ///
    /// -> function
    entry-fn: entry,
    /// The function to use to lay out CV sections.
    ///
    /// See @section.
    ///
    /// -> function
    section-fn: section,
    /// Whether to lay out a full document.
    ///
    /// If `true`, @cv.header-fn will be used to display a top-level heading for the CV, and
    /// @cv.footer-fn will be used to display a page footer on every page.  Note that since this
    /// results in `set document(...)` and `set page(...)`, it will only work when @cv is used at
    /// the top level.
    ///
    /// -> bool
    full-document: true,
    /// The function laying out the top-level heading of the CV.
    ///
    /// This function must take the following arguments and return `content`:
    ///
    /// ```typst
    /// my-header(name: none, email: none, homepage: none)
    /// ```
    ///
    /// -> function
    header-fn: _default-header,
    /// The function laying out the page footer of the CV.
    ///
    /// This function must take the following arguments and return `content`:
    ///
    /// ```typst
    /// my-footer(name: none, email: none, homepage: none)
    /// ```
    ///
    /// -> function
    footer-fn: _default-footer,
    /// The TOML input to parse.
    /// -> str | path | bytes
    input,
) = {
    let data = parse-cv-data(input)

    if full-document {
        set document(title: [#data.name -- Curriculum Vitae])
        set page(footer: footer-fn(name: data.name, email: data.email, homepage: data.homepage))
    }

    header-fn(name: data.name, email: data.email, homepage: data.homepage)
    h(1em)

    let _render-section(section) = {
        section-fn(
            title: section.title,
            level: section.level,
            breakable: section.breakable,
            entries: section
                .entries
                .map(entry => if entry.kind == "section" {
                    _render-section(entry)
                } else {
                    entry-fn(
                        title: entry.title,
                        institution: entry.institution,
                        location: entry.location,
                        aside: entry.aside,
                        entry.body,
                    )
                })
        )
    }

    data.sections.map(section => _render-section(section)).join()
}
