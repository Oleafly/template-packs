<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" default-locale="en-US">
  <info>
    <title>Poster Compact</title>
    <id>https://weygoldt.example/poster-compact</id>
    <updated>2024-01-01T00:00:00Z</updated>
    <category citation-format="numeric"/>
  </info>
  <citation collapse="citation-number">
    <sort><key variable="citation-number"/></sort>
    <layout prefix="[" suffix="]" delimiter=", ">
      <text variable="citation-number"/>
    </layout>
  </citation>
  <bibliography second-field-align="flush" entry-spacing="0" line-spacing="1">
    <sort><key variable="citation-number"/></sort>
    <layout suffix=".">
      <text variable="citation-number" prefix="[" suffix="]"/>
      <group delimiter=". ">
        <group delimiter=" ">
          <names variable="author">
            <name form="short" et-al-min="2" et-al-use-first="1" delimiter=", "/>
            <et-al term="et-al" font-style="italic"/>
          </names>
          <date variable="issued" prefix="(" suffix=")">
            <date-part name="year"/>
          </date>
        </group>
        <text variable="title"/>
        <text variable="container-title" font-style="italic"/>
      </group>
    </layout>
  </bibliography>
</style>
