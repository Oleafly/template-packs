\usepackage{lastpage}

\usepackage{fancyhdr}

% élargir header/footer par rapport au texte
\fancyhfoffset[L]{1cm}
\fancyhfoffset[R]{1cm}
%\setlength{\headheight}{20mm}


\newcommand{\HESfooter}{
	\parbox{17.2cm}{
	\vspace{-18pt}
	\footnotesize
	\textcolor{magenta}{\textsc{Engineering and Architecture}}
	\vspace{2pt}
	\hrule
	\vspace{-6pt}
	\begin{flushright}
	\scriptsize %\tiny
	\begin{tabular}{|p{7cm}|p{5cm}|p{3cm}|}
	\hline
	\FooterTL &  \FooterTM & \multicolumn{1}{|r|}{\parbox{3cm}{~\hfill\FooterTR}} \\
	\hline
	 \FooterBL & \FooterBM & \multicolumn{1}{|r|}{\thepage} \\
	\hline
	\end{tabular}
	\end{flushright}
	}
}

% empty
% page de garde
\fancypagestyle{empty}{
    \fancyhf{}  % vide tout d'abord
    % En-tête
    \renewcommand{\headrulewidth}{0pt}     % trait en haut
    \fancyhead[R]{\includegraphics[width=1cm]{template/corner-top-right.pdf}}
    % Pied de page
    \renewcommand{\footrulewidth}{0pt} % trait en bas
}

% plain
% pages d'en-tête de chapitres
\fancypagestyle{plain}{
    \fancyhf{}  % vide tout d'abord
    % En-tête
    \renewcommand{\headrulewidth}{0pt}     % trait en haut
    \fancyhead[R]{\includegraphics[width=1cm]{template/corner-top-right.pdf}}
    % Pied de page
    \renewcommand{\footrulewidth}{0pt} % trait en bas
    \fancyfoot[L]{\includegraphics[width=1cm]{template/corner-bot-left.pdf}}
    \fancyfoot[R]{\HESfooter}
}


% Style général
\fancypagestyle{mainstyle}{
    \fancyhf{}  % vide tout d'abord
    % En-tête
    \renewcommand{\headrulewidth}{0pt}     % trait en haut
    \fancyhead[L]{\includegraphics[width=3cm]{template/hes-so-master.png}\vspace*{-2mm}}
    \fancyhead[R]{\includegraphics[width=1cm]{template/corner-top-right.pdf}}
    % Pied de page
    \renewcommand{\footrulewidth}{0pt} % trait en bas
    \fancyfoot[L]{\includegraphics[width=1cm]{template/corner-bot-left.pdf}}
    \fancyfoot[R]{\HESfooter}
}%style

% Appliquer ce style par défaut
\pagestyle{mainstyle}



% redefine the mark to access the simple text
% il doit être après la définition des styles
% Drapeau pour en-tête complet ou simplifié
\newif\iffullchaptermark \fullchaptermarkfalse
\makeatletter
\renewcommand{\chaptermark}[1]{%
  \iffullchaptermark
    \markboth{\@chapapp\ \thechapter\ : #1}{}    % Chapitre N : Titre
  \else
    \markboth{#1}{} % Titre
  \fi
}
\makeatother








