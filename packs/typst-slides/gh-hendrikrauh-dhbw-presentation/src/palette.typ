/// Corporate design colours and fonts of the DHBW.
///
/// The red matches the official DHBW brand colour (`#e2001a`), the greys are
/// taken from the DHBW logo wordmark.

#let dhbw-red = rgb("#e2001a")
#let dhbw-red-dark = rgb("#b30014")
#let dhbw-ink = rgb("#1d2126")
/// Body and title colour of the DHBW template (`#5c6971`), measured from the
/// official PowerPoint deck.
#let dhbw-slate = rgb("#5c6971")
#let dhbw-gray = rgb("#7d8990")
#let dhbw-gray-mid = rgb("#b6bdc2")
#let dhbw-gray-faint = rgb("#e2e6e9")
#let dhbw-white = rgb("#ffffff")

/// Default typeface. Source Sans 3 is the heading font of the DHBW Typst
/// templates (`clean-dhbw`, `supercharged-dhbw`).
#let dhbw-font = "Source Sans 3"

/// Typeface of inline and block code — Fira Code with the Nerd Font glyphs.
#let dhbw-code-font = "FiraCode Nerd Font Mono"

/// Typeface of equations.
#let dhbw-math-font = "Fira Math"
