  number: rgb("#b5cea8"),
  function: rgb("#dcdcaa"),
  class: rgb("#4ec9b0"),
  builtin: rgb("#c586c0"),
)

#let rust-syntax = (
  keyword: rgb("#c586c0"),
  string: rgb("#ce9178"),
  comment: rgb("#6a9955"),
  number: rgb("#b5cea8"),
  function: rgb("#dcdcaa"),
  type: rgb("#4ec9b0"),
  macro: rgb("#d7ba7d"),
)

#let font-sizes = (
  tiny: 8pt,
  small: 10pt,
  normal: 12pt,
  large: 14pt,
  heading: 16pt,
  title: 24pt,
