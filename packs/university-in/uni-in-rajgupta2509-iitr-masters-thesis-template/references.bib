% ============================================================
%  BIBLIOGRAPHY FILE
%
%  CITATION STYLES:
%  This template uses natbib. Two styles are supported:
%
%  SEG author-year (default):
%    \citep{key}   →  (Smith and Jones, 2020)
%    \citet{key}   →  Smith and Jones (2020)
%
%  IEEE numbered (if switched in preamble.tex):
%    \cite{key}    →  [1]
%
%  HOW TO ADD REFERENCES:
%  Copy the relevant entry type below, fill in the fields,
%  and use the cite key in your .tex files.
% ============================================================

% ---- Example: Journal Article ------------------------------
@article{Smith2020,
  author  = {Smith, John A. and Jones, Mary B.},
  title   = {Title of the journal article},
  journal = {Name of the Journal},
  year    = {2020},
  volume  = {65},
  number  = {3},
  pages   = {123--145},
  doi     = {10.1000/example.doi}
}

% ---- Example: Book -----------------------------------------
@book{Jones2018,
  author    = {Jones, Mary B.},
  title     = {Title of the Book},
  publisher = {Publisher Name},
  address   = {City, Country},
  year      = {2018},
  edition   = {2nd}
}

% ---- Example: Conference Paper -----------------------------
@inproceedings{Brown2019,
  author    = {Brown, Robert C.},
  title     = {Title of the conference paper},
  booktitle = {Proceedings of the Conference Name},
  year      = {2019},
  pages     = {456--460},
  address   = {City, Country}
}

% ---- Example: Technical Report / Thesis --------------------
@phdthesis{Williams2021,
  author = {Williams, Sarah D.},
  title  = {Title of the PhD Thesis},
  school = {University Name},
  year   = {2021}
}

