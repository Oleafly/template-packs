// Все данные конкретной лабораторной собраны здесь.
// Текстовые значения пишутся в кавычках, числа — без кавычек.
#let config = (
  // Полное название университета. Квадратные скобки позволяют писать
  // многострочный текст и использовать внутри него разметку Typst.
  institution: [
    Федеральное государственное автономное образовательное учреждение
    высшего образования «Национальный исследовательский университет ИТМО»
  ],

  // Данные, из которых собирается название работы на титульном листе.
  work_type: "Лабораторная работа",
  lab_number: 1,
  discipline: "Тестовый предмет",

  // Укажите тему строкой, например "Разработка требований".
  // Значение none полностью скрывает строку темы.
  topic: none,

  // Данные студента, преподавателя и группы/потока.
  student: "Тестов Тест Тестович",
  reviewer: "Фубаров Фубар Фубарович",
  group_label: "Поток",
  group: "2.3",

  // Нижняя строка титульного листа и номер варианта в задании.
  city: "Санкт-Петербург",
  year: 2100,
  variant: "2027",

  // Максимальный уровень заголовков в содержании: 1, 2 или 3.
  toc_depth: 3,

  // true включает номера страниц, false оставляет их скрытыми.
  show_page_numbers: false,

  // Справочное имя каталога результата. Фактический путь сборки задаётся
  // переменной OUTPUT в корневом Makefile.
  output_name: "docs/report",

  // Укажите "Times New Roman", если шрифт установлен в системе.
  // Liberation Serif работает без дополнительной установки.
  font_family: "Liberation Serif",

  // Здесь можно переименовать стандартные разделы отчёта.
  labels: (
    contents: "Содержание",
    task: "Задание",
    work: "Ход работы",
    conclusion: "Вывод",
    sources: "Источники",
  ),
)
