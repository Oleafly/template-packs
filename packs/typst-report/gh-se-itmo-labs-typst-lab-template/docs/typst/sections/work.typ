#import "../template/components/figures.typ": report-figure
#import "../template/components/tables.typ": report-table
#import "../template/components/code.typ": code-block, inline-code

#let work = [
  == Цель работы

  Подготовить структуру отчёта и проверить, что оформление отделено от
  содержания. Все параметры титульного листа находятся в одном
  конфигурационном файле, а разделы отчёта хранятся отдельно.

  == Выполнение работы

  На первых трёх этапах создан базовый шаблон страницы, настроены типографика и
  уровни заголовков, реализованы титульный лист и динамическое содержание.

  === Структура исходников

  Общий шаблон расположен отдельно от конкретной лабораторной работы. Поэтому
  новая работа может использовать те же правила оформления и переопределять
  только метаданные и содержимое разделов.

  === Автоматическое содержание

  Пункты содержания формируются из заголовков. При добавлении, удалении или
  переносе подразделов номера страниц обновляются во время сборки PDF.

  === Изображения

  Изображение передаётся в компонент вместе с подписью и шириной. Подпись и
  номер формируются автоматически; на @fig:build-flow показана схема сборки
  отчёта.

  #report-figure(
    image("../assets/images/template-flow.svg", width: 100%),
    width: 92%,
    caption: [Схема сборки отчёта],
  ) <fig:build-flow>

  === Таблицы

  Для таблиц используется единый стиль границ, отступов и заголовков. Шапка
  автоматически повторяется, если таблица переносится на следующую страницу.

  #report-table(
    columns: (1.1fr, 2.2fr, 0.8fr),
    header: ([Файл], [Назначение], [Править]),
    rows: (
      ([config.typ], [Метаданные и параметры отчёта], [Да]),
      ([main.typ], [Точка входа и подключение разделов], [Редко]),
      ([sections/work.typ], [Основное содержимое хода работы], [Да]),
      ([template/report.typ], [Общие правила оформления документа], [Нет]),
    ),
  )

  #pagebreak()
  === Исходный код

  Короткие имена файлов можно выделять прямо в строке, например
  #inline-code("config.typ"). Для больших фрагментов предусмотрены язык,
  подсветка синтаксиса, заголовок, имя файла и опциональные номера строк.

  #code-block(
    "#let config = (\n  lab_number: 1,\n  font_family: \"Liberation Serif\",\n)\n\n#let output = \"docs/report/report.pdf\"",
    lang: "typ",
    filename: [docs/typst/config.typ],
    line-numbers: true,
  )

  #code-block(
    "def build_report(source: str) -> str:\n    output = \"docs/report/report.pdf\"\n    return f\"typst compile {source} {output} --root .\"",
    lang: "py",
    title: [Пример команды сборки],
  )
]
